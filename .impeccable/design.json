  "narrative": {
    "northStar": "The Contemporary Linguistic Atlas",
    "overview": "Compact walnut library: rag-paper outer surfaces, grid inside data regions, and photographic leather books with spine-first pull-out and hinged covers. A/B/C preserved.",
    "keyCharacteristics": [
      "Photographic walnut bookcase header and right inspector.",
      "Ivory sketchbook network and readable paper evidence.",
      "Live book shortcuts with restrained opt-out motion."
    ],
    "rules": [
      {
        "name": "The Evidence Rule",
        "body": "Colour and marks describe real learner or source data; layout proximity is never a similarity claim.",
        "section": "colors"
      },
      {
        "name": "The Readable Atlas Rule",
        "body": "Keep the reading surface quiet and preserve the hierarchy between headings, character glyphs, controls and evidence.",
        "section": "typography"
      }
    ],
    "dos": [
      "Do preserve the native search, selects, details and dialog vocabulary.",
      "Do keep vocabulary bands, recommendation rings and score signals consistent between legends and dynamic graphics.",
      "Do preserve the A network / B explanation / C coverage structure and responsive stacking.",
      "Do keep selected-character reading, definition and source evidence together."
    ],
    "donts": [
      "Don't imply that graph proximity is linguistic similarity or that pilot vocabulary bands are official character levels."
    ]
  }
