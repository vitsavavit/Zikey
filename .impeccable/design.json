  "narrative": {
    "northStar": "The Contemporary Linguistic Atlas",
    "overview": "A contemporary linguistic atlas on warm paper. Baskerville headings and Songti character entries give the workspace a reference-book character; native sans-serif controls keep search, learner state and evidence practical. Quiet rules organize a dense learning tool, with a navy binding header and restrained data colour.\n\nThe visual system supports the existing connected-character workspace. Its material is typography, paper tone and documented graph marks; decorative imagery, page curls, grain and ornamental stamps are excluded by the confirmed direction.",
    "keyCharacteristics": [
      "Warm paper with an ink-blue binding header.",
      "Serif editorial hierarchy, Ming character glyphs and sans-serif controls.",
      "Flat divided regions and explicit data encodings."
    ],
    "rules": [
      {
        "name": "The Evidence Rule",
        "body": "Colour and marks describe real learner or source data; layout proximity is never a similarity claim.",
        "section": "colors"
      },
      {
        "name": "The Readable Atlas Rule",
        "body": "Keep the reading surface quiet and preserve the hierarchy between headings, character glyphs, controls and evidence.",
        "section": "typography"
      }
    ],
    "dos": [
      "Do preserve the native search, selects, details and dialog vocabulary.",
      "Do keep vocabulary bands, recommendation rings and score signals consistent between legends and dynamic graphics.",
      "Do preserve the A network / B explanation / C coverage structure and responsive stacking.",
      "Do keep selected-character reading, definition and source evidence together."
    ],
    "donts": [
      "Don't add decorative imagery, grain, page curls, gradients or ornamental stamps.",
      "Don't turn the atlas into a literal book prop or replace the workspace with a hero or card grid.",
      "Don't imply that graph proximity is linguistic similarity or that pilot vocabulary bands are official character levels."
    ]
  }
}
